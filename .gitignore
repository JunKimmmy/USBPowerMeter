# KiCad lock files
*.lck

# Root-level library tables (contain local/absolute paths to KiCad's installed libraries)
/fp-lib-table
/sym-lib-table

# Exported files
*.csv
*.net
*.xml
*.rpt

# KiCad automatic backups
*-backups/

# KiCad Python library pickle cache
lib_pickle_dir/

# Local history
.history/
other files/

# OS files
.DS_Store
Thumbs.db

# STM32CubeIDE build output
Firmware/ST/Debug/

# Claude Code settings
.claude/
**/.claude/

# STM32CubeIDE workspace settings (machine-local)
Firmware/ST/.settings/
